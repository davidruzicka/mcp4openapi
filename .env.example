# MCP Server Configuration
MCP4_OPENAPI_SPEC_PATH=./profiles/examples/gitlab/openapi.yaml
MCP4_PROFILE_PATH=./profiles/examples/gitlab/developer-profile.json
MCP4_TRANSPORT=stdio

# Local HTTP Transport (when MCP4_TRANSPORT=http)
MCP4_HOST=127.0.0.1
MCP4_PORT=3003
# Remote HTTP Transport
# MCP4_HOST=0.0.0.0
# MCP4_ALLOWED_ORIGINS="*.company.com,192.168.0.0/16,10.0.0.0/8"

# Session Management
MCP4_SESSION_TIMEOUT_MS=1800000

# Heartbeat (for reverse proxy keepalive e.g.)
MCP4_HEARTBEAT_ENABLED=false
MCP4_HEARTBEAT_INTERVAL_MS=30000

# Metrics (Prometheus)
MCP4_METRICS_ENABLED=false
MCP4_METRICS_PATH=/metrics

# Logging
MCP4_LOG_LEVEL=info
MCP4_LOG_FORMAT=console

# API Configuration
MCP4_API_TOKEN=your-api-token-here
MCP4_API_BASE_URL=https://gitlab.com/api/v4
