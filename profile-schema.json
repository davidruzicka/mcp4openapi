    "SessionCookieConfig": {
      "type": "object",
      "properties": {
        "login_endpoint": {
          "type": "string",
          "description": "Login endpoint path or absolute URL. Relative paths are resolved against the profile base_url."
        },
        "login_method": {
          "type": "string",
          "const": "POST",
          "description": "HTTP method for login. Currently only POST is supported."
        },
        "login_content_type": {
          "type": "string",
          "enum": [
            "application/json",
            "application/x-www-form-urlencoded"
          ],
          "description": "Login payload content type."
        },
        "username_field": {
          "type": "string",
          "description": "Login form field name for username/login identifier."
        },
        "username_from_env": {
          "type": "string",
          "description": "Environment variable containing the login username."
        },
        "password_field": {
          "type": "string",
          "description": "Login form field name for password."
        },
        "password_from_env": {
          "type": "string",
          "description": "Environment variable containing the login password."
        },
        "login_static_headers": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E",
          "description": "Optional extra headers to send with the login request."
        },
        "login_static_body": {
          "$ref": "#/definitions/Record%3Cstring%2Cstring%3E",
          "description": "Optional extra fields to include in the login request body."
        },
        "cookie_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed session cookie names accepted from Set-Cookie. At least one matching cookie must be returned by login."
        },
        "login_allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional allowlist for absolute login endpoints beyond the profile base URL host. Supports exact hosts and *.example.com wildcards."
        },
        "reauth_on_statuses": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "HTTP status codes that should trigger relogin and a single replay attempt."
        },
        "failure_backoff_ms": {
          "type": "number",
          "description": "Backoff applied after failed login/relogin to avoid login storms."
        },
        "expiry_skew_ms": {
          "type": "number",
          "description": "Treat cookies expiring within this skew window as expired."
        }
      },
      "required": [
        "login_endpoint",
        "username_field",
        "username_from_env",
        "password_field",
        "password_from_env",
        "cookie_names"
      ],
      "description": "Session cookie authentication configuration\n\nSupports direct server-to-server login flows where the API exchanges username/password for a session cookie instead of issuing API tokens."
    },
