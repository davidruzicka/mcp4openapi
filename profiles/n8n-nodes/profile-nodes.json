{
  "$schema": "../../profile-schema.json",
  "profile_name": "n8n-node-list",
  "description": "Single-purpose tool for fetching the list of supported n8n nodes from an n8n instance.",
  "openapi_spec_path": "./openapi.yaml",
  "interceptors": {
    "base_url": {
      "value_from_env": "N8N_NODES_BASE_URL",
      "default": "http://localhost:5678"
    }
  },
  "tools": [
    {
      "name": "n8n_nodes",
      "description": "List n8n node definitions (full or summary).",
      "metadata_params": [
        "action"
      ],
      "operations": {
        "list_full": "getNodes",
        "list_summary": "getNodes"
      },
      "parameters": {
        "action": {
          "type": "string",
          "enum": [
            "list_full",
            "list_summary"
          ],
          "description": "Action to perform",
          "required": true
        }
      },
      "response_fields": {
        "list_summary": [
          "displayName",
          "group",
          "description",
          "usableAsTool"
        ]
      }
    }
  ]
}
