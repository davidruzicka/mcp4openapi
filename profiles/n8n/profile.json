          "updatedAt",
          "authors"
        ],
        "get_tags": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ],
        "update_tags": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  ],
  "interceptors": {
    "auth": {
      "type": "custom-header",
      "header_name": "X-N8N-API-KEY",
      "value_from_env": "N8N_TOKEN"
    },
    "base_url": {
      "value_from_env": "N8N_API_BASE_URL",
      "default": "http://localhost:5678/api/v1"
    }
  }
}
