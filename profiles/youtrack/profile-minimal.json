{
  "$schema": "../../profile-schema.json",
  "profile_name": "youtrack-minimal",
  "description": "Minimal YouTrack profile for testing",

  "interceptors": {
    "auth": {
      "type": "bearer",
      "value_from_env": "MCP4_API_TOKEN"
    }
  },

  "tools": [
    {
      "name": "list_issues",
      "description": "List issues from YouTrack",
      "operations": {
        "list": "get_/issues"
      },
      "parameters": {
        "action": {
          "type": "string",
          "description": "Tool action selector",
          "enum": [
            "list"
          ],
          "required": true
        },
        "query": {
          "type": "string",
          "description": "Issue search query",
          "required_for": [
            "list"
          ]
        },
        "top": {
          "type": "integer",
          "description": "Maximum items to return"
        }
      }
    }
  ]
}
