{
  "$schema": "../../src/testing/test-schema.ts",
  "profile_name": "youtrack-minimal",
  "scenarios": [
    {
      "name": "List Issues",
      "tool": "list_issues",
      "arguments": {
        "action": "list",
        "query": "project: TEST",
        "top": 5
      },
      "mocks": [
        {
          "operationId": "get_/issues",
          "response": {
            "status": 200,
            "body": []
          }
        }
      ],
      "expect": {
        "success": true
      }
    },
    {
      "name": "List Issues - Missing Action",
      "tool": "list_issues",
      "arguments": {
        "query": "project: TEST"
      },
      "mocks": [],
      "expect": {
        "success": false,
        "error_message_regex": "action"
      }
    }
  ],
  "coverage": {
    "require_all_actions": true,
    "skip_actions": {}
  }
}
