{
  "$schema": "../../profile-schema.json",
  "profile_name": "Softeria SharePoint Read-Only",
  "profile_id": "softeria-sharepoint",
  "profile_aliases": ["ms365-sharepoint"],
  "description": "Consent-gated proxy to a centrally hosted Softeria Microsoft 365 MCP server, restricted to read-only SharePoint/drive tools and Sites.Selected/Files.Read delegated permissions.",
  "tools": [],
  "consent_gate": {
    "required": true,
    "rules_version": "v1",
    "rules_summary": "This connection allows the AI assistant to read files and metadata from approved SharePoint sites using your Microsoft 365 identity.",
    "education_resource": "https://intranet.example/ms365-ai-rules",
    "identity_source": "profile_oauth"
  },
  "interceptors": {
    "auth": {
      "type": "oauth",
      "oauth_config": {
        "issuer": "${env:SOFTERIA_ENTRA_ISSUER}",
        "client_id": "${env:SOFTERIA_ENTRA_CLIENT_ID}",
        "client_secret": "${env:SOFTERIA_ENTRA_CLIENT_SECRET}",
        "redirect_uri": "${env:SOFTERIA_OAUTH_REDIRECT_URI}",
        "scopes": ["openid", "Files.Read", "Sites.Selected"]
      }
    }
  },
  "upstream_mcp": {
    "name": "softeria",
    "transport": {
      "type": "http-streamable",
      "url": "https://softeria.internal.example/mcp"
    },
    "auth": {
      "type": "bearer"
    },
    "tools": {
      "allow": ["*sharepoint*", "*site*", "*drive*", "download-bytes", "get-download-url"]
    },
    "timeout_ms": 30000,
    "html_description_policy": "strip",
    "tool_description_length_policy": "truncate"
  },
  "upstream_mcp_from_env": "SOFTERIA_UPSTREAM_MCP"
}
